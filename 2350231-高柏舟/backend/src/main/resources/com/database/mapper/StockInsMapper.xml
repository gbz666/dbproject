<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.database.mapper.StockInsMapper">

    <resultMap id="BaseResultMap" type="com.database.pojo.StockIns">
            <id property="id" column="id" />
            <result property="stockInCode" column="stock_in_code" />
            <result property="purchaseOrderId" column="purchase_order_id" />
            <result property="stockInDate" column="stock_in_date" />
            <result property="note" column="note" />
            <result property="createdAt" column="created_at" />
            <result property="createdById" column="created_by_id" />
            <result property="updatedAt" column="updated_at" />
            <result property="updatedById" column="updated_by_id" />
    </resultMap>

    <sql id="Base_Column_List">
        id,stock_in_code,purchase_order_id,stock_in_date,note,created_at,
        created_by_id,updated_at,updated_by_id
    </sql>

    <select id="selectByPrimaryKey" parameterType="java.lang.Long" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List" />
        from stock_ins
        where  id = #{id} 
    </select>
    <resultMap id="StockInVOResultMap" type="com.database.vo.StockInVO">
        <id property="id" column="stock_in_id" />
        <result property="stockInCode" column="stock_in_code" />
        <result property="purchaseOrderCode" column="purchaseOrderCode" />
        <result property="supplierName" column="supplierName" />
        <result property="orderDate" column="orderDate" />
        <result property="productCode" column="productCode" />
        <result property="productName" column="productName" />
        <result property="purchaseQuantity" column="purchaseQuantity" />
        <result property="note" column="note" />
        <result property="creatorName" column="creatorName" />

        <collection property="warehouseDetails" ofType="com.database.vo.WarehouseStockVO">
            <result property="warehouseId" column="warehouse_id" />
            <result property="warehouseName" column="warehouse_name" />
            <result property="quantity" column="item_qty" />
        </collection>
    </resultMap>
    <select id="selectStockInDetails" resultMap="StockInVOResultMap">
        SELECT
        si.id AS stock_in_id,
        si.stock_in_code,
        po.purchase_code AS purchaseOrderCode,
        po.order_date AS orderDate,
        s.supplier_name AS supplierName,
        p.product_code AS productCode,
        p.product_name AS productName,
        poi.quantity AS purchaseQuantity,
        si.note,
        st.staff_name AS creatorName,
        -- 仓库明细字段
        w.id AS warehouse_id,
        w.warehouse_name,
        sii.quantity AS item_qty
        FROM purchase_orders po
        JOIN suppliers s ON po.supplier_id = s.id
        JOIN purchase_order_items poi ON po.id = poi.purchase_order_id
        JOIN products p ON poi.product_id = p.id
        inner JOIN stock_ins si ON si.purchase_order_id = po.id AND si.is_deleted = 0
        LEFT JOIN stock_in_items sii ON si.id = sii.stock_in_id AND sii.product_id = p.id
        LEFT JOIN warehouses w ON sii.warehouse_id = w.id
        LEFT JOIN staffs st ON si.created_by_id = st.id
        <where>
            AND po.is_deleted = 0
            <if test="purchaseOrderCode != null and purchaseOrderCode != ''">
                AND po.purchase_code LIKE CONCAT('%', #{purchaseOrderCode}, '%')
            </if>
            <if test="supplierName != null and supplierName != ''">
                AND s.supplier_name LIKE CONCAT('%', #{supplierName}, '%')
            </if>
            <if test="productName != null and productName != ''">
                AND p.product_name LIKE CONCAT('%', #{productName}, '%')
            </if>
            <if test="serialNumber != null and serialNumber != ''">
                AND sii.serial_numbers LIKE CONCAT('%', #{serialNumber}, '%')
            </if>
        </where>
        order by si.id DESC
    </select>

    <delete id="deleteByPrimaryKey" parameterType="java.lang.Long">
        delete from stock_ins
        where  id = #{id} 
    </delete>
    <insert id="insert" keyColumn="id" keyProperty="id" parameterType="com.database.pojo.StockIns" useGeneratedKeys="true">
        insert into stock_ins
        ( id,stock_in_code,purchase_order_id,stock_in_date,note,created_at,
        created_by_id,updated_at,updated_by_id)
        values (#{id},#{stockInCode},#{purchaseOrderId},#{stockInDate},#{note},#{createdAt},
        #{createdById},#{updatedAt},#{updatedById})
    </insert>
    <insert id="insertSelective" keyColumn="id" keyProperty="id" parameterType="com.database.pojo.StockIns" useGeneratedKeys="true">
        insert into stock_ins
        <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="id != null">id,</if>
                <if test="stockInCode != null">stock_in_code,</if>
                <if test="purchaseOrderId != null">purchase_order_id,</if>
                <if test="stockInDate != null">stock_in_date,</if>
                <if test="note != null">note,</if>
                <if test="createdAt != null">created_at,</if>
                <if test="createdById != null">created_by_id,</if>
                <if test="updatedAt != null">updated_at,</if>
                <if test="updatedById != null">updated_by_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                <if test="id != null">#{id},</if>
                <if test="stockInCode != null">#{stockInCode},</if>
                <if test="purchaseOrderId != null">#{purchaseOrderId},</if>
                <if test="stockInDate != null">#{stockInDate},</if>
                <if test="note != null">#{note},</if>
                <if test="createdAt != null">#{createdAt},</if>
                <if test="createdById != null">#{createdById},</if>
                <if test="updatedAt != null">#{updatedAt},</if>
                <if test="updatedById != null">#{updatedById},</if>
        </trim>
    </insert>
    <update id="updateByPrimaryKeySelective" parameterType="com.database.pojo.StockIns">
        update stock_ins
        <set>
                <if test="stockInCode != null">
                    stock_in_code = #{stockInCode},
                </if>
                <if test="purchaseOrderId != null">
                    purchase_order_id = #{purchaseOrderId},
                </if>
                <if test="stockInDate != null">
                    stock_in_date = #{stockInDate},
                </if>
                <if test="note != null">
                    note = #{note},
                </if>
                <if test="createdAt != null">
                    created_at = #{createdAt},
                </if>
                <if test="createdById != null">
                    created_by_id = #{createdById},
                </if>
                <if test="updatedAt != null">
                    updated_at = #{updatedAt},
                </if>
                <if test="updatedById != null">
                    updated_by_id = #{updatedById},
                </if>
        </set>
        where   id = #{id} 
    </update>
    <update id="updateByPrimaryKey" parameterType="com.database.pojo.StockIns">
        update stock_ins
        set 
            stock_in_code =  #{stockInCode},
            purchase_order_id =  #{purchaseOrderId},
            stock_in_date =  #{stockInDate},
            note =  #{note},
            created_at =  #{createdAt},
            created_by_id =  #{createdById},
            updated_at =  #{updatedAt},
            updated_by_id =  #{updatedById}
        where   id = #{id} 
    </update>
    <update id="softDeleteStockIn">
        UPDATE stock_ins
        SET is_deleted = 1,
            deleted_at = NOW(),
            updated_by_id = #{operatorId}
        WHERE id = #{id}
    </update>
</mapper>
