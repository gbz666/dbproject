# LLM 配置（OpenAI-compatible）
# --- 方案 A：本地 Ollama（推荐初期开发使用）---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_ID=qwen2.5-coder:7b
LLM_API_KEY=ollama

# --- 方案 B：Google Gemini（云端，需要科学上网）---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL_ID=gemini-3-flash-preview
# LLM_API_KEY=your-api-key-here

# 图表输出目录（相对路径基于项目根目录解析，Java 侧读取同一目录）
CHART_OUTPUT_DIR=charts

# 服务监听配置
AIAGENT_HOST=0.0.0.0
AIAGENT_PORT=8001
