# LLM 配置（OpenAI-compatible）
# --- 方案 A：本地 Ollama（推荐初期开发使用）---
# 注：Ollama OpenAI 兼容层默认 num_ctx=2048，qwen2.5-coder:7b 原生支持 32K。
# 推荐基于 Modelfile（aiagent/Modelfile）创建一个 num_ctx=8192 的派生模型：
#   ollama create qwen-sql:7b -f aiagent/Modelfile
# 然后把 LLM_MODEL_ID 改为 qwen-sql:7b。
# 即便仍用 qwen2.5-coder:7b，llm_client.py 也会通过 extra_body 透传 num_ctx 兜底。
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_ID=qwen-sql:7b
LLM_API_KEY=ollama

# --- 方案 B：Google Gemini（云端，需要科学上网）---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL_ID=gemini-3-flash-preview
# LLM_API_KEY=your-api-key-here

# Java 后端地址（MCP Tool Server，试跑 SQL 用）
JAVA_BACKEND_URL=http://localhost:8080

# Java 后端鉴权配置（二选一）：
# 方案1：固定 Token（简单，但会随 jwt.expiration 过期）
# JAVA_BACKEND_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# 方案2：服务账号自动登录获取 Token（推荐）
# JAVA_BACKEND_STAFF_NAME=管理员
# JAVA_BACKEND_PASSWORD=123456

# 服务监听配置
AIAGENT_HOST=0.0.0.0
AIAGENT_PORT=8001
