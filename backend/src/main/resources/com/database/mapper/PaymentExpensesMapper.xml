    <select id="selectPageList" parameterType="com.database.dto.PaymentExpenseQuery"
            resultType="com.database.vo.PaymentExpenseVO">
        SELECT pe.id, pe.payment_no AS paymentNo, pe.supplier_id AS supplierId,
               s.supplier_name AS supplierName,
               pe.purchase_invoice_id AS purchaseInvoiceId,
               pi.invoice_no AS purchaseInvoiceNo,
               pe.amount, pe.payment_date AS paymentDate,
               pe.method, pe.remark,
               pe.created_at AS createdAt, pe.updated_at AS updatedAt
        FROM payment_expenses pe
        LEFT JOIN suppliers s ON s.id = pe.supplier_id AND s.is_deleted = 0
        LEFT JOIN purchase_invoices pi ON pi.id = pe.purchase_invoice_id AND pi.is_deleted = 0
        <where>
            AND pe.is_deleted = 0
            <if test="supplierName != null and supplierName != ''">
                AND s.supplier_name LIKE CONCAT('%', #{supplierName}, '%')
            </if>
            <if test="paymentNo != null and paymentNo != ''">
                AND pe.payment_no LIKE CONCAT('%', #{paymentNo}, '%')
            </if>
            <if test="method != null and method != ''">
                AND pe.method = #{method}
            </if>
        </where>
        ORDER BY pe.created_at DESC
    </select>

    <update id="softDelete">
        UPDATE payment_expenses SET is_deleted = 1 WHERE id = #{id}
