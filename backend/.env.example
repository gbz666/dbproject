# MySQL 数据库配置
DB_URL=jdbc:mysql:///dbproject
DB_USERNAME=root
DB_PASSWORD=your_db_password

# AI 数据库（只读账户）
AI_DB_URL=jdbc:mysql:///dbproject
AI_DB_USERNAME=ai_readonly
AI_DB_PASSWORD=your_ai_db_password

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AI Agent 服务
AI_AGENT_URL=http://localhost:8001

# JWT 密钥 (至少256位长)
JWT_SECRET=your_jwt_secret_key_here